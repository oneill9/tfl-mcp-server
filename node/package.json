{
  "name": "@oneill9/tfl-mcp-server",
  "version": "2.0.0",
  "description": "Real-time London transport data through MCP",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tfl-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oneill9/tfl-mcp-server.git"
  },
  "homepage": "https://github.com/oneill9/tfl-mcp-server#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-resources.mjs",
    "prepack": "npm run build",
    "test": "vitest run --exclude test/contract.test.ts",
    "test:package": "bash ../scripts/test-npm-distribution.sh",
    "test:conformance": "npm run typecheck:conformance && bash scripts/test-conformance.sh",
    "typecheck:conformance": "tsc -p tsconfig.conformance.json",
    "contractTest": "vitest run test/contract.test.ts",
    "start": "node dist/index.js",
    "build:mcpb": "bash ../scripts/build-mcpb.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/conformance": "0.2.0-alpha.11",
    "@types/node": "^26",
    "tsx": "4.23.13",
    "typescript": "^7",
    "vitest": "^5"
  }
}
